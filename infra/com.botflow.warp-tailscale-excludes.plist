<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hourly refresh of Tailscale's DERP/control addresses in WARP's exclude list.
     Install: /Library/LaunchDaemons/com.botflow.warp-tailscale-excludes.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.botflow.warp-tailscale-excludes</string>
  <key>ProgramArguments</key><array><string>/usr/local/sbin/warp-tailscale-excludes.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>3600</integer>
</dict>
</plist>
